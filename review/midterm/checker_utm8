import ipywidgets as widgets
from IPython.display import display, clear_output
import math

def run_checker(user_code, exercise_num):
    # Setup standard data for collection questions
    score = [65, 12, 88, 45, 76, 3, 94, 51, 29, 60, 82, 18, 41, 99, 34, 55, 7, 85, 62, 20, 48, 73, 15, 90, 57]
    
    try:
        # local_env provides the starting variables for students
        local_env = {'score': score.copy(), 'math': math}
        exec(user_code, {}, local_env)
        
        # --- EASY QUESTIONS (Topics 1 & 2) ---
        if exercise_num == 1:
            # --- PART 1: Check the student's current output ---
            if 'result' not in local_env:
                return "❌ Error: Please save your final result in a variable named 'result'."
            
            # --- PART 2: The Logic Validation (The "Hidden" Test) ---
            test_cases = [5, 12.5, 2.2] 
            
            for t_rad in test_cases:
                try:
                    # Create a fresh environment for each test case
                    test_env = {'math': math, 'radius': t_rad}
                    
                    # Run the student's code string against this new radius
                    exec(user_code, {}, test_env)
                    
                    # Calculate what the answer SHOULD be
                    expected_area = math.pi * (t_rad**2)
                    expected_str = f"{expected_area:.2f}"
                    
                    # Compare with student's variable
                    if test_env.get('result') != expected_str:
                        return f"❌ Failed. Your logic doesn't work when radius is {t_rad}. Expected '{expected_str}'."
                
                except Exception as e:
                    return f"⚠️ Your code crashed during hidden testing. Error: {e}"

            return "✅ Excellent! Your code works for the current value and all hidden test cases."

        elif exercise_num == 2:
            # List manipulation (Add/Remove)
            s = local_env.get('score')
            if s and s[0] == 100 and s[-1] == 999: 
                return "✅ Correct! 100 inserted at start and 999 appended."
            return "❌ Hint: Use score.insert(0, 100) and score.append(999)"

        elif exercise_num == 3:
            # Dictionary Basics
            std = local_env.get('student')
            if isinstance(std, dict) and std.get('age') == 20: 
                return "✅ Correct! Dictionary created."
            return "❌ Hint: student = {'name': 'John', 'age': 20}"

        elif exercise_num == 4:
            # Type Conversion
            if local_env.get('x_int') == 10 and isinstance(local_env.get('x_int'), int): 
                return "✅ Correct!"
            return "❌ Hint: Use int() to convert the string."

        # --- MEDIUM QUESTIONS (Topics 3 & 4) ---
        elif exercise_num == 5:
            # If-Else Logic
            status = local_env.get('status')
            val = local_env.get('n')
            if (val % 2 == 0 and status == "Even") or (val % 2 != 0 and status == "Odd"): 
                return "✅ Correct!"
            return "❌ Logic mismatch for Even/Odd."

        elif exercise_num == 6:
            # Membership (in operator)
            exists = local_env.get('exists')
            if exists is True: 
                return "✅ Correct! 99 is in the list."
            return "❌ Hint: exists = 99 in score"

        elif exercise_num == 7:
            # While Loop with break
            if local_env.get('count') == 5: 
                return "✅ Correct! Loop stopped at 5."
            return "❌ Hint: Use if i == 5: break"

        elif exercise_num == 8:
            # Collection Sort
            s = local_env.get('score')
            if s == sorted(score, reverse=True): 
                return "✅ Correct! List sorted descending."
            return "❌ Hint: score.sort(reverse=True)"

        # --- HARD QUESTIONS (Topics 5 & 6) ---
        elif exercise_num == 9:
            # For loop + Range (Sum of Evens)
            if local_env.get('total_even') == 510: 
                return "✅ Correct! Sum of even numbers is 510."
            return "❌ Hint: Use if s % 2 == 0: total_even += s"

        elif exercise_num == 10:
            # Nested Loop (Pattern)
            if local_env.get('stars') == 15: 
                return "✅ Correct! Nested logic found."
            return "❌ Ensure you used a nested loop for the pattern."

        elif exercise_num == 11:
            # Iterating Dict of Lists (BMI)
            if local_env.get('bmi_list') and abs(local_env['bmi_list'][0] - 24.2) < 0.5: 
                return "✅ Correct!"
            return "❌ Calculation error in BMI loop."

        elif exercise_num == 12:
            # Continue statement in loop
            if local_env.get('filtered_sum') == 1286: # Sum without the number 3
                return "✅ Correct! Loop skipped number 3 using continue."
            return "❌ Hint: if s == 3: continue"

        return "❌ Logic incomplete. Check variable names."

    except Exception as e:
        return f"⚠️ Error: {e}"

def create_ui(exercise_num, default_code):
    code_input = widgets.Textarea(value=default_code, layout={'height': '160px', 'width': '95%'})
    btn = widgets.Button(description="Check Code", button_style='primary')
    out = widgets.Output()
    
    def on_click(b):
        with out:
            clear_output()
            # 1. Run the student's code openly first so they see their own output
            print("--- Your Code Output ---")
            # We use the same run_checker logic but ensure it prints results below
            result = run_checker(code_input.value, exercise_num)
            
            print("\n--- Checker Result ---")
            print(result)
            
    btn.on_click(on_click)
    display(code_input, btn, out)
